```
# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*

# Build outputs
dist/
build/
*.js.map

# Cache directories
.npm/
.yarn/
.cache/

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
.coverage

# Python cache (if any Python files exist in the project)
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary files
*.tmp
*.temp
```