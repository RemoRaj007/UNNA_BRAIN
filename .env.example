APP_NAME=UNNA Brain API
APP_ENV=development
APP_DEBUG=false
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/unna_brain
OIDC_ISSUER=https://login.microsoftonline.com/common/v2.0
OIDC_AUDIENCE=unna-brain-api
JWT_ALGORITHM=RS256
JWT_JWKS_URL=https://login.microsoftonline.com/common/discovery/v2.0/keys
R2_ENDPOINT_URL=https://example.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=unna-brain
R2_REGION=auto
R2_SIGNED_URL_EXPIRY_SECONDS=900
UPLOAD_MAX_SIZE_MB=20
