# Local Development Environment Configuration
# Copy this file to .env.local and fill in with your local values

# Application Settings
APP_NAME=UNNA Brain API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unna_brain

# Authentication (Microsoft Entra ID / OIDC)
# Set AUTH_ENABLED=false to disable authentication (uses test user with all roles)
# Set AUTH_ENABLED=true to enforce JWT validation
AUTH_ENABLED=false

# OIDC Configuration (required only when AUTH_ENABLED=true)
OIDC_ISSUER=https://login.microsoftonline.com/common/v2.0
OIDC_AUDIENCE=unna-brain-api
JWT_ALGORITHM=RS256
JWT_JWKS_URL=https://login.microsoftonline.com/common/discovery/v2.0/keys

# CORS Settings
CORS_ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:5173"]

# Cloudflare R2 Storage (Optional - for local development)
# R2_ENDPOINT_URL=https://youraccount.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET_NAME=unna-brain
# R2_REGION=auto
# R2_SIGNED_URL_EXPIRY_SECONDS=900

# Upload Settings
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ALLOWED_EXTENSIONS=["csv", "xlsx", "xls"]

# Frontend Settings
FRONTEND_URL=http://localhost:3000

# Cloudflare Pages Deployment
# Set these when using 'npm run deploy'
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token

# LLM Provider API Keys (optional)
# Used by /api/v1/ai/providers and /api/v1/ai/generate
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
